datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id              Int      @id @default(autoincrement())
  fullName        String
  emailAddress    String
  phoneNumber     String?
  companyName     String?
  serviceInterestedIn String
  projectBudget   String?
  projectDetails  String   @db.Text
  createdAt       DateTime @default(now())
}

model Seo {
  id          Int      @id @default(autoincrement())
  pageurl     String
  title       String
  description String   @db.Text   // Long text
  script      String   @db.Text   // Long text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
