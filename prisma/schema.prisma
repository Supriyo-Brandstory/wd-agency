datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id              Int      @id @default(autoincrement())
  fullName        String
  emailAddress    String
  phoneNumber     String?
  companyName     String?
  serviceInterestedIn String
  projectBudget   String?
  projectDetails  String   @db.Text
  submitted_page_url String?
  createdAt       DateTime @default(now())
}

model Seo {
  id          Int      @id @default(autoincrement())
  pageurl     String
  title       String
  description String   @db.Text   // Long text
  script      String   @db.Text   // Long text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model BlogCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  description String   @db.Text   // Long text
  blogs     Blog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String
  image       String
  slug        String   @unique
  content     String   @db.LongText
  checklistTitle String?
  checklistItems String? @db.Text
  categoryId  Int
  category    BlogCategory @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sitemap {
  id        Int      @id @default(autoincrement())
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TemplateCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  templates Template[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Template {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  price           String
  image           String
  description     String   @db.LongText
  features        String?  @db.Text
  demoFolder      String?  // Path to extracted ZIP files
  livePreviewUrl  String?
  categoryId      Int
  category        TemplateCategory @relation(fields: [categoryId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
