d:["$","$L1d",null,{"testimonials":[{"id":1,"name":"Marcus Thorne","text":"Website Development Agency built a digital presence that perfectly reflects our industrial scale. Our new site has significantly improved our credibility during major regional manufacturing tenders.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Amina Al-Farsi","text":"A highly professional team with a deep understanding of the manufacturing sector. They delivered a robust, authoritative website that has become a key driver for our international supply leads.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Samuel Grant","text":"Excellent service from start to finish. Our search rankings for specialized industrial terms have improved dramatically, and the site's performance is exceptional.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
