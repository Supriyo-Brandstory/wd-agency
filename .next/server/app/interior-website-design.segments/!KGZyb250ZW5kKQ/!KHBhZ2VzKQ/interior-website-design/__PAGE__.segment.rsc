d:["$","$L1d",null,{"testimonials":[{"id":1,"name":"Sophie Chen","text":"Website Development Agency created a website that perfectly captures my design aesthetic. Our portfolio has never looked better, and we've seen a significant increase in high-end inquiries.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Ahmed Al-Mansoori","text":"A highly creative team that understands the luxury market. They delivered a stunning website that has positioned our firm as a leader in commercial design in Dubai.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Emma Wright","text":"Excellent service with a keen eye for detail. The visual performance of the site is exceptional, and our search rankings have improved dramatically for interior design terms.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
