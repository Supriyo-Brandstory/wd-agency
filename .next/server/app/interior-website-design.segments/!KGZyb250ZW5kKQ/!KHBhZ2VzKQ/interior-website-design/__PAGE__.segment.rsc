b:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","children":["$","h2",null,{"children":"Creative Website Solutions for Design Firms"}]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","p",null,{"children":"We build design websites that adapt to the specific focus of your studio. Every platform is planned around your portfolio, creative philosophy, and client engagement goals."}]}]]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex CommonWhyWebsiteDevelopment-module__smXB6a__bottom","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","dangerouslySetInnerHTML":{"__html":"<p><b>Residential Interior Design:</b> We create websites that focus on home aesthetics, lifestyle, and personal luxury, emphasizing comfort and individual style for private homeowners.</p>\n                                <p><b>Commercial Design Studios:</b> For firms focusing on offices, retail, and hospitality, our designs focus on functionality, scale, and brand integration, positioning you for large-scale tenders.</p>\n                                <p><b>Architectural Design:</b> Websites for architects focus on structure, space, and technical innovation, showcasing your ability to design iconic buildings and functional environments.</p>\n                                <p><b>Furniture & Product Design:</b> We design platforms for specialized designers that focus on product detail and craftsmanship, utilizing high-end product pages and manufacturing stories.</p>\n                            "}}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","$L3",null,{"src":{"src":"/_next/static/media/why-choose.41d762f4.webp","width":1132,"height":1128,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"},"alt":"Why Website Development"}]}]]}]]}]
