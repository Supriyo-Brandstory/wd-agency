b:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","children":["$","h2",null,{"children":"Aesthetic Website Solutions for Specialized Surgeons"}]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","p",null,{"children":"We build medical websites that adapt to the specific focus of your practice. Every platform is planned around your procedure catalog, surgical expertise, and patient engagement goals."}]}]]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex CommonWhyWebsiteDevelopment-module__smXB6a__bottom","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","dangerouslySetInnerHTML":{"__html":"<p><b>Facial Plastic Surgery:</b> We create comprehensive websites that highlight rhinoplasty, facelifts, and eyelid surgery, emphasizing harmony, balance, and specialized skill.</p>\n                                <p><b>Body Contouring & Sculpting:</b> For body specialists, our designs focus on liposuction, tummy tucks, and non-invasive fat reduction, showcasing transformational results and patient safety. </p>\n                                <p><b>Breast & Reconstruction:</b> Websites for breast specialists focus on surgical options, patient education, and natural-looking results, utilizing detailed galleries and procedure guides. </p>\n                                <p><b>Non-Invasive Med-Spas:</b> We design platforms for rejuvenation centers that focus on fillers, Botox, and skin health, utilizing vibrant product pages and appointment booking systems.</p>\n                            "}}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","$L3",null,{"src":{"src":"/_next/static/media/why-choose.41d762f4.webp","width":1132,"height":1128,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"},"alt":"Why Website Development"}]}]]}]]}]
