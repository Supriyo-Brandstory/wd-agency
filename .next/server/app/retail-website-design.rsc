1e:["$","$L33",null,{"testimonials":[{"id":1,"name":"Sophie Bennett","text":"Website Development Agency built a digital presence that perfectly reflects our boutique's style. Our new e-commerce site has significantly improved our sales and brand perception.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Ahmad Al-Mansouri","text":"A highly professional team with a deep understanding of the retail sector. They delivered a vibrant website that has become a key driver for our international brand growth.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Emily White","text":"Excellent service from start to finish. Our digital presença now truly matches the quality of our products, and the user experience is simply flawless.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
