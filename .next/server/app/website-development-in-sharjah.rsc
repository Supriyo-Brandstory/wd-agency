17:["$","div",null,{"className":"frame-1200 pt-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","h2",null,{"className":"text-center sm-text-start mb-20","dangerouslySetInnerHTML":{"__html":"Why Choose Website Development Agency as Your Web Design<br/> Company in Sharjah"}}],["$","p",null,{"className":"text-center mb-40 sm-text-start","children":"Among many other web design companies in Sharjah, we stand as the best with a strong understanding of local business, audience demographics, and the latest digital trends. We are not just a website design company, we are the transformation partner for businesses supporting their digital expansion."}],["$","div",null,{"className":"commonThreeCard-module__C821FW__grid","children":[["$","div","0",{"className":"commonThreeCard-module__C821FW__card","children":[["$","div",null,{"className":"commonThreeCard-module__C821FW__imgbox","children":["$","$L7",null,{"src":{"src":"/_next/static/media/Strategic-Problem-Solving.961c8ba6.png","width":110,"height":110,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/png;base64,"},"alt":"Icon"}]}],["$","h4",null,{"className":"my-15","children":"Strategic Problem Solving"}],["$","p",null,{"children":"We are experts in creating visually stunning, functional, and conversion-focused websites tailored to your branding. Every design we create is to deliver a perfect blend of creativity and performance."}],"$undefined"]}],["$","div","1",{"className":"commonThreeCard-module__C821FW__card","children":[["$","div",null,{"className":"commonThreeCard-module__C821FW__imgbox","children":["$","$L7",null,{"src":{"src":"/_next/static/media/FocusedApproach.dc092fb1.png","width":93,"height":93,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/png;base64,"},"alt":"Icon"}]}],["$","h4",null,{"className":"my-15","children":"Focused Approach"}],["$","p",null,{"children":"As the best web design experts, we focus on building a clear strategy, addressing unique needs, and delivering exceptional websites that resonate with your branding.  "}],"$undefined"]}],["$","div","2",{"className":"commonThreeCard-module__C821FW__card","children":[["$","div",null,{"className":"commonThreeCard-module__C821FW__imgbox","children":["$","$L7",null,{"src":{"src":"/_next/static/media/Partnership-Commitment.6769dc19.png","width":110,"height":110,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/png;base64,"},"alt":"Icon"}]}],["$","h4",null,{"className":"my-15","children":"Partnership Commitment"}],"$L2e","$undefined"]}],"$L2f","$L30","$L31"]}]]}]
18:["$","div",null,{"style":{"background":"url(/_next/static/media/our-approch.e717370c.webp) no-repeat bottom center / cover"},"className":"sm-mb-50 commonApproch-module__iQB09G__container","children":["$","div",null,{"className":"frame-1200 py-100 sm-pt-0  sm-px-20","children":[["$","h2",null,{"children":"Our Approach to Web Design in Sharjah"}],["$","div",null,{"dangerouslySetInnerHTML":{"__html":" <p  class='mb-20'>We emphasize designing websites that are visually impressive, functional, and deliver the best user experience. A Good website adds credibility to your brand, improves customer trust, and acts as a premier sales channel for around the clock. We blend the most advanced technology with an SEO-based structure for a better browsing experience for every visitor. </p>\n                     <p>We put our utmost attention to detail, starting from color palettes, images, layouts, and responsive design. We believe responsive web design stands firmly with your brand and business objectives. Whether designing websites for an e-commerce business, service provider, or healthcare business, we keep in mind your audience and business goals and audience network. Our designs are attractive and SEO optimized, which will surely help you leverage a better Google ranking, better visibility, and traffic.  </p>"},"className":"commonApproch-module__iQB09G__scroller"}],["$","$L8",null,{"className":"white-btn","href":"/contact-us","children":"Contact Us"}]]}]}]
19:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"commonServices-module__ns43GG__topSection","children":[["$","div",null,{"className":"commonServices-module__ns43GG__left","style":{"--width":"40%"},"children":["$","h2",null,{"className":"mb-20 ","children":"Best Web Design Services in Sharjah - Website Development Agency"}]}],["$","div",null,{"className":"commonServices-module__ns43GG__right","style":{"--width":"60%"},"children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":" <p>The business landscape of Sharjah is growing digital, and it has become mandatory for brands to make a perpetual impact. As more customers search, browse, and shop online, your website becomes the point of contact and brings the most valuable leads and conversions.   </p>\n                <p class='my-20'>As the pioneer web design agency in Sharjah, we deliver high-performance websites utilizing the latest technology upgrades. Every website we create comes with the most important core elements: fast loading, mobile responsiveness, SEO optimization, and seamless navigation.</p>\n                "}}]}]]}],["$","div",null,{"className":"commonServices-module__ns43GG__bottomSection","style":{"--bg-url":"url(/_next/static/media/shaejahservicebg.1b8a56f5.webp)"},"children":["$","div",null,{"className":"frame-700","style":{"margin":"0 0"},"children":[["$","h4",null,{"className":"mb-20","children":"Key features of our web design services in Sharjah include:"}],["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<ul class='ml-50'>\n                <li>Custom website designs tailored to your industry and business-specific objectives.</li>\n                <li>Responsive web design and layout optimized for all screen sizes (Mobile, Desktop, Tablet)</li>\n                <li>Easy navigation and strategic Call-to-Action placements</li>\n                <li>State-of-the-art visuals with strong and consistent branding</li>\n                <li>Secure coding practices adhering to industry-standard security protocols</li>\n            </ul>\n            "}}]]}]}]]}]
1a:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","h2",null,{"className":"text-center sm-text-start","children":"Best Web Design Services that Drive Measurable Results"}],["$","p",null,{"className":"my-20 text-center sm-text-start","children":"Great website design connects a visitor’s journey from initial impact to conversation. We are the best expert web design agency creating websites that don’t just look good and functional, but also work across all devices. From intuitive UX design to high end visuals, we outline websites attract, engage, and keep users engaged."}],["$","h3",null,{"className":"text-center mb-40 sm-text-start","children":"Our Core Strengths"}],["$","div",null,{"className":"commonResult-module__-FHNbW__cardbox","children":[["$","div","0",{"className":"commonResult-module__-FHNbW__card","children":[["$","$L7",null,{"src":{"src":"/_next/static/media/custom-design.765ec358.png","width":604,"height":850,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/png;base64,"},"alt":"Custom Design","className":"commonResult-module__-FHNbW__image"}],["$","div",null,{"className":"commonResult-module__-FHNbW__overlay","children":[["$","h4",null,{"className":"mb-10","children":"Custom Design"}],["$","p",null,{"children":"Fully responsive for smartphones, tablets, and desktops."}]]}]]}],["$","div","1",{"className":"commonResult-module__-FHNbW__card","children":[["$","$L7",null,{"src":{"src":"/_next/static/media/SEO-Centric.4b0b08f4.webp","width":604,"height":850,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"},"alt":"Custom Design","className":"commonResult-module__-FHNbW__image"}],["$","div",null,{"className":"commonResult-module__-FHNbW__overlay","children":[["$","h4",null,{"className":"mb-10","children":"SEO-Centric"}],["$","p",null,{"children":"Organized with on-page SEO basics in mind."}]]}]]}],["$","div","2",{"className":"commonResult-module__-FHNbW__card","children":[["$","$L7",null,{"src":