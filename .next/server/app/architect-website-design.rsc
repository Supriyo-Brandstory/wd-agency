1e:["$","$L34",null,{"testimonials":[{"id":1,"name":"Michael Chen","text":"Website Development Agency truly understood our studio's aesthetic. Our new digital portfolio has been a game-changer for high-profile pitches and client meetings.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Sarah Al-Maktoum","text":"A highly professional team that delivered a stunning, high-converting website for our boutique architecture firm. The attention to detail was exceptional.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"James Wilson","text":"Excellent service from start to finish. Our search rankings improved dramatically, and we have seen a steady increase in enquiries from major developers.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
