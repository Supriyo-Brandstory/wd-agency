1d:["$","$L33",null,{"testimonials":[{"id":1,"name":"Alexander Volkov","text":"Website Development Agency built our DEX interface with incredible speed and technical precision. Their understanding of Web3 integration is top-notch in the Dubai market.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Li Jing","text":"Professional, innovative, and security-conscious. They delivered an NFT marketplace that is both a work of art and a high-performing technical platform. Five stars!","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Sarah Al-Kamali","text":"Exceptional design that captured our project's vision perfectly. Their ongoing support with Web3 updates has been invaluable as we scale across the UAE and beyond.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
