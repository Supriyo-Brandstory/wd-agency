d:["$","$L1e",null,{"testimonials":[{"id":1,"name":"Daniel R","text":"Website Development Agency transformed our online presence. Within 3 months, our sales doubled thanks to their Shopify development expertise.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Sophia K","text":"Professional, efficient, and creative—the best ecommerce development agency in UAE we’ve worked with.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"James P","text":"From design to launch, everything was seamless. Their team handled even complex Magento integrations with ease.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
