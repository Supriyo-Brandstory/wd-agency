19:["$","$L32",null,{"heding":"Modern Full-Stack Tech Stack","subheding":"Our stack of technology keeps your apps fast, reliable, and scalable. We blend the leading-edge tools for frontend and backend development to create extraordinary digital experiences that are customized to your business objectives.","techData":[{"name":"React","image":{"src":"/_next/static/media/reacticon.02b52050.svg","width":114,"height":102,"blurWidth":0,"blurHeight":0},"gradient":"linear-gradient(180deg, #61DAFB 0%, #03C9FF 118.42%)"},{"name":"Node.js","image":{"src":"/_next/static/media/nodejsicon.313091c9.svg","width":138,"height":85,"blurWidth":0,"blurHeight":0},"gradient":"linear-gradient(180deg, #6CC04A 16.44%, #539E43 60.27%)"},{"name":"Laravel","image":{"src":"/_next/static/media/laravelicon.25bb0dbf.svg","width":169,"height":39,"blurWidth":0,"blurHeight":0},"gradient":"linear-gradient(180deg, #FF6960 16.44%, #FF2D20 60.27%)"},{"name":"WordPress","image":{"src":"/_next/static/media/wordpressicon.24f1e2fa.svg","width":90,"height":90,"blurWidth":0,"blurHeight":0},"gradient":"linear-gradient(180deg, #4A87A3 16.44%, #21759B 60.27%)"},{"name":"Magento","image":{"src":"/_next/static/media/magentoicon.2fa0eef2.svg","width":90,"height":106,"blurWidth":0,"blurHeight":0},"gradient":"linear-gradient(180deg, #FF7949 0%, #EC6737 118.42%)"},{"name":"Shopify","image":{"src":"/_next/static/media/shopifyicon.371ffea0.svg","width":93,"height":106,"blurWidth":0,"blurHeight":0},"gradient":"linear-gradient(180deg, #CEF682 16.44%, #95BF46 60.27%)"},{"name":"Flutter","image":{"src":"/_next/static/media/fluttericon.32c3e23e.svg","width":79,"height":98,"blurWidth":0,"blurHeight":0},"gradient":"linear-gradient(180deg, #45D1FD 16.44%, #02539A 100%)"},{"name":"React Native","image":{"src":"/_next/static/media/reactnativeicon.12387626.svg","width":87,"height":95,"blurWidth":0,"blurHeight":0},"gradient":"linear-gradient(180deg, #61DAFB 0%, #03C9FF 118.42%)"},{"name":"PHP","image":{"src":"/_next/static/media/phpicon.6accd517.svg","width":143,"height":73,"blurWidth":0,"blurHeight":0},"gradient":"linear-gradient(180deg, #697EBA 17.27%, #6E81B6 73.33%)"},{"name":"Python","image":{"src":"/_next/static/media/pythonicon.833d81af.svg","width":101,"height":101,"blurWidth":0,"blurHeight":0},"gradient":"linear-gradient(180deg, #387EB8 -73.67%, #FFC331 27.62%)"},{"name":"AWS","image":{"src":"/_next/static/media/awsicon.93292eb6.svg","width":141,"height":83,"blurWidth":0,"blurHeight":0},"gradient":"linear-gradient(180deg, #F7DCB4 17.91%, #FF9900 65.66%)"},{"name":"MongoDB","image":{"src":"/_next/static/media/mongodbicon.6e80d528.svg","width":105,"height":105,"blurWidth":0,"blurHeight":0},"gradient":"linear-gradient(180deg, #6CAC48 17.91%, #599636 65.66%)"}]}]
1a:["$","$L33",null,{"heding":"From Concept to Interactive Experience","subheding":"We follow agile web design methodology from idea to implementation- the treatment of accuracy and openness. At Website Development Agency, we don’t just deliver code, we deliver experiences engineered for success.","processData":[{"id":"01","title":"Requirement Analysis","description":"We begin by finding out what you want to achieve, who your ideal users are, and what your technical environment is."},{"id":"02","title":"UI/UX & Wireframing","description":"We produce the user flow charts and UI/UX layout designs that guarantee easy navigation and usability."},{"id":"03","title":"Frontend Design","description":"The experts in our team create responsive, pixel-perfect, and interactive designs that are a true reflection of your idea."},{"id":"04","title":"Testing & QA","description":"Along with checking the application under different browsers, we also do performance testing."},{"id":"05","title":"Testing & QA","description":"Prior to launch, the Website Development Agency team will conduct meticulous performance, usability and security testing. We will identify bugs and browser compatibility, while also ensuring a fast-loading site for the best user experience."},{"id":"06","title":"Support & Maintenance","description":"Continuous updates, monitoring, and performance optimization after your website launch to ensure it stays fast, secure, and high-quality."}]}]
