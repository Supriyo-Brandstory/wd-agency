1d:["$","$L32",null,{"testimonials":[{"id":1,"name":"Capt. Mansoor Ahmed","text":"Website Development Agency delivered a platform that perfectly reflects our charter company’s commitment to excellence. The booking system is flawless and our clients love it.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Elena Petrova","text":"The technical depth and design quality are unmatched. They understood the complexities of the aviation sector and built a site that stands out globally.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Robert Davidson","text":"Professional, efficient, and technically skilled. Our new website has significantly improved our lead generation from international flight departments.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
