b:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","children":["$","h2",null,{"children":"Active Website Solutions for Specialized Brands"}]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","p",null,{"children":"We build sports websites that adapt to the specific focus of your studio. Every platform is planned around your active mission, community footprint, and client engagement goals."}]}]]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex CommonWhyWebsiteDevelopment-module__smXB6a__bottom","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","dangerouslySetInnerHTML":{"__html":"<p><b>Youth Academies & Schools:</b> We create comprehensive websites that highlight safety, skill progression, and coaching excellence, emphasizing personal growth for young athletes.</p>\n                                <p><b>Professional Clubs & Teams:</b> For pro organizations, our designs focus on fan engagement, ticket sales, and player stats, positioning you as a pinnacle of regional athletic success.</p>\n                                <p><b>Fitness & Personal Training:</b> Websites for fitness specialists focus on workout plans, nutrition advice, and client transformations, showcasing your ability to deliver healthy lifestyle results.</p>\n                                <p><b>Tournament & Event Organizers:</b> We design platforms for event planners that focus on registration, scheduling, and live results, utilizing detailed event pages and interactive maps.</p>\n                            "}}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","$L3",null,{"src":{"src":"/_next/static/media/why-choose.41d762f4.