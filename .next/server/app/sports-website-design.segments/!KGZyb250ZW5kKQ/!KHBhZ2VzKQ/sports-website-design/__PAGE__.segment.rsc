d:["$","$L1c",null,{"testimonials":[{"id":1,"name":"Jake Williams","text":"Website Development Agency built a digital presence that perfectly reflects our club's energy. Our member sign-up rate has improved dramatically since the relaunch.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Laila Al-Kamali","text":"A highly professional team with a deep understanding of the sports sector. They delivered a vibrant website that has become a key driver for our academy's growth in Dubai.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Robert Miller","text":"Excellent service from start to finish. Our search rankings for 'football coaching' in Dubai have improved dramatically, and the site's performance is exceptional.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
