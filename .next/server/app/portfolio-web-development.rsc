wn-module__YFR4nq__price","children":"AED 8,000- 12,000"}]]}],["$","div","3",{"className":"CommonCostBreakdown-module__YFR4nq__grid","children":[["$","p",null,{"children":"Premium"}],["$","p",null,{"children":"Premium, custom-built"}],["$","p",null,{"className":"CommonCostBreakdown-module__YFR4nq__price","children":"AED 12,000+"}]]}]]]}]]}]
