1c:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","children":["$","h2",null,{"children":"Comprehensive Wellness Solutions for Your Practice"}]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","p",null,{"children":"We build medical websites that adapt to the specific focus of your mental health practice. Every platform is planned around your therapeutic focus, clinical expertise, and client engagement goals."}]}]]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex CommonWhyWebsiteDevelopment-module__smXB6a__bottom","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","dangerouslySetInnerHTML":{"__html":"<p><b>Counselling & Psychotherapy:</b> We create compassionate websites that highlight treatment specializations, individual approach, and patient stories, emphasizing safety and personal growth.</p>\n                                <p><b>Child & Adolescent Therapy:</b> For pediatric specialists, our designs focus on family trust, developmental expertise, and play-based healing, positioning you as a key partner for parents in Dubai.</p>\n                                <p><b>Corporate Wellness Consulting:</b> Websites for corporate mental health firms focus on organizational resilience, employee wellbeing frameworks, and professional scale, showcasing your ability to support local businesses.</p>\n                                <p><b>Specialized Support Groups:</b> We design platforms for specialized groups that focus on community engagement, peer support stories, and resource hubs, utilizing detailed event pages and member portals.</p>\n                            "}}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a_