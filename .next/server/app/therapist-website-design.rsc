16:["$","$L2d",null,{"heding":"Therapist Website Design in Dubai, UAE- Our Services","subheding":"We provide comprehensive digital solutions designed to help therapists build trust and grow their practice in the UAE.","services":[{"title":"Website UI/UX Design","desc":"Creating visually appealing layouts, intuitive navigation, and structured user journeys that reflect brand identity while improving usability and overall visitor experience.","img":{"src":"/_next/static/media/service-1.9340cc63.webp","width":1256,"height":600,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"Website UI/UX Design","btnname":"Contact Us","link":"/contact-us"},{"title":"Website Development","desc":"Building secure, scalable websites with clean code and required functionality, ensuring smooth performance, stability, and long-term flexibility across business use cases.","img":{"src":"/_next/static/media/why-choose-wd-agency.6c5ff342.webp","width":1256,"height":1140,"blurWidth":8,"blurHeight":7,"blurDataURL":"data:image/webp;base64,"},"alt":"Website Development","btnname":"Contact Us","link":"/contact-us"},{"title":"Responsive Device Adaptation","desc":"Adapting websites to function seamlessly across mobiles, tablets, desktops, and different screen resolutions without layout issues or usability disruptions.","img":{"src":"/_next/static/media/service-3.004e6003.webp","width":1256,"height":600,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"Responsive Device Adaptation","btnname":"Contact Us","link":"/contact-us"},{"title":"Payment Gateway Integration","desc":"Integrating secure payment gateways to enable online transactions, bookings, subscriptions, or fee collections with smooth checkout experiences and reliable payment processing.","img":{"src":"/_next/static/media/service-6.c082bc09.webp","width":1256,"height":600,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"Payment Gateway Integration","btnname":"Contact Us","link":"/contact-us"},{"title":"Third-Party API & Tool Integration","desc":"Connecting websites with external systems like CRMs, booking platforms, analytics tools, or business software to extend functionality and streamline operations.","img":{"src":"/_next/static/media/tech-integration.d94955a1.webp","width":1256,"height":600,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"Third-Party API & Tool Integration","btnname":"Contact Us","link":"/contact-us"},{"title":"Website Maintenance & Support","desc":"Providing ongoing technical support, regular updates, bug fixes, monitoring, and system upkeep to ensure uninterrupted website performance and reliability.","img":{"src":"/_next/static/media/reservation-system.e05882ef.webp","width":1256,"height":600,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"Website Maintenance & Support","btnname":"Contact Us","link":"/contact-us"}]}]
