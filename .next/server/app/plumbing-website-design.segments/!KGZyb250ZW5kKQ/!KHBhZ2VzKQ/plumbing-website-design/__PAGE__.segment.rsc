b:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","children":["$","h2",null,{"children":"Maintenance Website Solutions for Specialized Firms"}]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","p",null,{"children":"We build service websites that adapt to the specific focus of your maintenance firm. Every platform is planned around your service catalog, local footprint, and client engagement goals."}]}]]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex CommonWhyWebsiteDevelopment-module__smXB6a__bottom","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","dangerouslySetInnerHTML":{"__html":"<p><b>Residential Plumbing Services:</b> We create comprehensive websites that highlight leak detection, bathroom renovations, and 24/7 repairs, emphasizing speed and home care.</p>\n                                <p><b>Commercial Facility Maintenance:</b> For business services, our designs focus on preventative maintenance, AMC packages, and specialized pipework, positioning you as a professional facility partner.</p>\n                                <p><b>Drainage & Sewer Specialists:</b> Websites for drainage experts focus on technical equipment (CCTV surveys, jetting), specialized skill stories, and large-scale industrial solutions.</p>\n                                <p><b>Water Heater & Filtration:</b> We design platforms for specialized equipment installers that focus on product quality and technical installation expertise, utilizing detailed service pages and product stories.</p>\n                            "}}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","$L3",null,{"src":{"src":"/_next/static/media/why-choose.41d762f4.webp","width":1132,"height":1128,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"},"alt":"Why Website Development"}]}]]}]]}]
