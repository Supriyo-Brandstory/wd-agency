d:["$","$L1d",null,{"testimonials":[{"id":1,"name":"David Smith","text":"Website Development Agency built a digital presence that has tripled our residential leads. Our new mobile-optimized site is the reason we're winning so many emergency calls now.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Mariam Al-Khalili","text":"A highly professional team with a deep understanding of the local service market. They delivered a helpful website that has become a key driver for our commercial maintenance contracts.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Steve Rogers","text":"Excellent service from start to finish. Our search rankings for 'plumber in Dubai' have improved dramatically, and the site's mobile performance is exceptional.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
