b:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","children":["$","h2",null,{"children":"Legal Website Solutions for Specialized Firms"}]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","p",null,{"children":"We build legal websites that adapt to the specific focus of your practice. Every platform is planned around your service catalog, legal expertise, and client engagement goals."}]}]]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex CommonWhyWebsiteDevelopment-module__smXB6a__bottom","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","dangerouslySetInnerHTML":{"__html":"<p><b>Corporate & Commercial Law:</b> We create comprehensive websites that highlight corporate advisory, M&A capabilities, and contract law expertise, emphasizing reliability for business clients.</p>\n                                <p><b>Litigation & Dispute Resolution:</b> For trial firms, our designs focus on case histories, courtroom experience, and strategic success stories, positioning you as a formidable advocate.</p>\n                                <p><b>Real Estate & Property Law:</b> Websites for property specialists focus on transaction support, regulatory compliance, and local real estate laws, showcasing your ability to navigate complex markets.</p>\n                                <p><b>Employment & Labor Law:</b> We design platforms for labor specialists that focus on hr compliance, worker rights, and employer protection, utilizing detailed resource pages and FAQs.</p>\n                            "}}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","$L3",null,{"src":{"src":"/_next/static/media/why-choos