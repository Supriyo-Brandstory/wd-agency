d:["$","$L1d",null,{"testimonials":[{"id":1,"name":"John Harrison","text":"Website Development Agency built a digital presence that perfectly reflects our firm's prestige. Our new site has significantly improved our ability to attract high-value corporate clients.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Laila Al-Saud","text":"A highly professional team with a deep understanding of the legal sector. They delivered an authoritative website that has become a key driver for our international consulting leads.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Robert Miller","text":"Excellent service from start to finish. Our search rankings for specialized legal terms have improved dramatically, and the site's performance is exceptional.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
