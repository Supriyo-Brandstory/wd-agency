1c:["$","$L37",null,{"testimonials":[{"id":1,"name":"Dr. Al Faisal","text":"Website Development Agency transformed our online presence. The new booking system has reduced our front-desk workload by 50% and patients love the ease of use.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Dr. Sarah Miller","text":"Highly professional and experienced team. They understood the clinical requirements perfectly and delivered a stunning, high-converting website for our ortho clinic.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Dr. Rajesh Gupta","text":"Excellent service from start to finish. Our search rankings improved dramatically, and we've seen a steady increase in new patient enquiries.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
