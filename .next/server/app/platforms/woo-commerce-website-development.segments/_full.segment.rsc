11:["$","$1","c",{"children":[[["$","div",null,{"className":"sm-mb-50 commonBanner2-module__m8QleG__commonbanner2","style":{"--bg":"url(/_next/static/media/woocommerce-banner.8246e2e1.webp) no-repeat center center / cover"},"children":["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-10 sm-px-20 commonBanner2-module__m8QleG__content","children":[["$","h2",null,{"dangerouslySetInnerHTML":{"__html":"Best WooCommerce Development </br>Company in UAE"}}],["$","p",null,{"className":"my-30","dangerouslySetInnerHTML":{"__html":"Our WooCommerce websites are characterized by speed, scalability, and </br>performance, serving as the foundation of your online business success."}}],["$","$L8",null,{"href":"/contact-us","className":"blue-btn","children":"Get a Free Consultation"}]]}]}],["$","$L15",null,{"title":"Dev. Services","items":[{"name":"UI/UX","link":"/services/ui-ux-design"},{"name":"Frontend Dev.","link":"/services/frontend-development"},{"name":"Full-stack Dev.","link":"/services/full-stack-development"},{"name":"Static Web Dev.","link":"/services/static-website-development"},{"name":"Dynamic Web Dev.","link":"/services/dynamic-website-development"},{"name":"Website Migration","link":"/services/website-migration-service"}]}],["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","h2",null,{"children":"WooCommerce Website Development"}],["$","div",null,{"className":"commonIntroduction-module__IKzCgq__flex","children":[["$","div",null,{"className":"commonIntroduction-module__IKzCgq__box","children":[["$","div",null,{"className":"commonIntroduction-module__IKzCgq__gapcontent","dangerouslySetInnerHTML":{"__html":" <p><a href=\"/\">Website Development Agency</a> has brought e-commerce to the doorstep of the business community by providing skilled professionals who create powerful WooCommerce solutions. Our WooCommerce developers build feature-rich and conversion-optimized online stores tailored to your brand and business objectives- whether you’re launching a new store or taking an existing one to the next level.</p>\n                    <p>As one of the most reliable WooCommerce development agencies in the UAE, we specialize in creating fully customized, responsive, and high-performing eCommerce stores powered by WordPress. Our goal is to help businesses deliver seamless shopping experiences that boost engagement, conversions, and customer loyalty.</p>\n                    "}}],["$","$L7",null,{"src":{"src":"/_next/static/media/woocommerce-dev-1.e0fd4f4b.webp","width":1256,"height":664,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"introimg-1"}]]}],["$","div",null,{"className":"commonIntroduction-module__IKzCgq__box","children":[["$","$L7",null,{"src":{"src":"/_next/static/media/woocommerce-dev-2.48dd6e41.webp","width":1256,"height":664,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"introimg-1"}],["$","div",null,{"className":"commonIntroduction-module__IKzCgq__gapcontent","dangerouslySetInnerHTML":{"__html":"  <p>We have 10+ years of extensive experience in <a href=\"/platforms/wordpress-website-development\">WordPress website development</a>, and we know how to make scalable and fast-loading websites. We are experts in everything from UI/UX, plugin development, custom websites, and theme-based WordPress development. We craft websites that stand out and make your customers fall in love with your brand, no matter how many alternatives they find online.</p>\n                <p>At Website Development Agency, we provide services across all locations in the UAE, starting from Dubai, Abu Dhabi, Sharjah, Ras Al Khaimah, and Ajman. Our WooCommerce development solutions are tailored to your specific requirements and in line with your brand objectives.</p>\n                    "}}]]}]]}]]}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e"],["$L1f","$L20","$L21","$L22","$L23"],"$L24"]}]
