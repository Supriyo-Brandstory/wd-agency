12:["$","$1","c",{"children":[[["$","div",null,{"className":"sm-mb-50 commonBanner2-module__m8QleG__commonbanner2","style":{"--bg":"url(/_next/static/media/angular-banner.3f11fe0b.webp) no-repeat center center / cover"},"children":["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-10 sm-px-20 commonBanner2-module__m8QleG__content","children":[["$","h2",null,{"dangerouslySetInnerHTML":{"__html":"Best Angular Website Development</br> Company in Dubai, UAE"}}],["$","p",null,{"className":"my-30","dangerouslySetInnerHTML":{"__html":"We create dynamic, scalable, and high-performance Angular </br>web applications for businesses across Dubai and the UAE."}}],["$","$L8",null,{"href":"/contact-us","className":"blue-btn","children":"Get a Free Consultation"}]]}]}],["$","$L16",null,{"title":"Dev. Services","items":[{"name":"UI/UX","link":"/services/ui-ux-design"},{"name":"Frontend Dev.","link":"/services/frontend-development"},{"name":"Full-stack Dev.","link":"/services/full-stack-development"},{"name":"Static Web Dev.","link":"/services/static-website-development"},{"name":"Dynamic Web Dev.","link":"/services/dynamic-website-development"},{"name":"Website Migration","link":"/services/website-migration-service"}]}],["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","h2",null,{"children":"Your Trusted Angular Development Partner"}],["$","div",null,{"className":"commonIntroduction-module__IKzCgq__flex","children":[["$","div",null,{"className":"commonIntroduction-module__IKzCgq__box","children":[["$","div",null,{"className":"commonIntroduction-module__IKzCgq__gapcontent","dangerouslySetInnerHTML":{"__html":" <p>Angular is a powerful front-end framework developed by Google, widely used for building dynamic, single-page web applications. We are among the top Angular website development companies in the UAE and create vibrant and interactive web solutions that match the exact requirements of startups, SMEs, and big enterprises.</p>\n                    <p>Our pool of certified Angular developers is well-versed in Angular, RxJS, TypeScript, and Angular CLI, which empowers us to create fast and scalable Single Page Applications (SPAs), real-time dashboards, and web portals of the highest standards for enterprises. With a focus on performance, maintainability, and seamless user experience, we ensure every application meets the evolving needs of modern businesses.</p>\n                    "}}],["$","$L7",null,{"src":{"src":"/_next/static/media/angular-banner-1.6691e03f.webp","width":1256,"height":664,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"introimg-1"}]]}],["$","div",null,{"className":"commonIntroduction-module__IKzCgq__box","children":[["$","$L7",null,{"src":{"src":"/_next/static/media/angular-banner-2.ab063a7a.webp","width":1256,"height":664,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"introimg-1"}],["$","div",null,{"className":"commonIntroduction-module__IKzCgq__gapcontent","dangerouslySetInnerHTML":{"__html":"  <p>If you are in Dubai, Abu Dhabi, Sharjah, or anywhere in the UAE, and MNC, or a startup, we bring your web solution to life so that it performs seamlessly and has user-friendly interfaces that enhance the experience of users. Your Angular-based website will be equipped to carry out intricate business operations and increased user demands, thanks to our emphasis on speed, security, responsiveness, and scalability during development.</p>\n                <p>At Website Development Agency, our team is not just about Angular website development, rather, we are about fashioning digital experiences that connect people and ‍‌‍‍‌‍‌‍‍‌possibilities.</p>\n                    "}}]]}]]}]]}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"],["$L20","$L21","$L22","$L23","$L24"],"$L25"]}]
