11:["$","$1","c",{"children":[[["$","div",null,{"className":"sm-mb-50 commonBanner2-module__m8QleG__commonbanner2","style":{"--bg":"url(/_next/static/media/wordpress-banner.8102f565.webp) no-repeat center center / cover"},"children":["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-10 sm-px-20 commonBanner2-module__m8QleG__content","children":[["$","h2",null,{"dangerouslySetInnerHTML":{"__html":"WordPress Website <br>Development Company in UAE"}}],["$","p",null,{"className":"my-30","dangerouslySetInnerHTML":{"__html":"We design and develop responsive, secure, and high-performing <br>WordPress websites that drive business growth in Dubai, <br>Abu Dhabi, and across the UAE."}}],["$","$L8",null,{"href":"/contact-us","className":"blue-btn","children":"Get a Free Consultation"}]]}]}],["$","$L15",null,{"title":"Dev. Services","items":[{"name":"UI/UX","link":"/services/ui-ux-design"},{"name":"Frontend Dev.","link":"/services/frontend-development"},{"name":"Full-stack Dev.","link":"/services/full-stack-development"},{"name":"Static Web Dev.","link":"/services/static-website-development"},{"name":"Dynamic Web Dev.","link":"/services/dynamic-website-development"},{"name":"Website Migration","link":"/services/website-migration-service"}]}],["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","h2",null,{"children":"WordPress Website Development"}],["$","div",null,{"className":"commonIntroduction-module__IKzCgq__flex","children":[["$","div",null,{"className":"commonIntroduction-module__IKzCgq__box","children":[["$","div",null,{"className":"commonIntroduction-module__IKzCgq__gapcontent","dangerouslySetInnerHTML":{"__html":" <p>Your‍‌‍‍‌‍‌‍‍‌ website is the first impression of your business in a digitally-driven world. <a href=\"/\">Website Development Agency</a> is the company that can expert in custom WordPress website development in the UAE. We provide powerful, scalable, and aesthetically appealing website that really gets your business noticed. We have been up to this for more than ten years.</p>\n                    <p>So, we had no problem teaming up with the startups, SMEs, and big companies in the UAE to build a strong online presence through powerful WordPress solutions. Our team of certified WordPress developers and designers is passionate about creating websites that are creative and high-performing. </p>\n                    "}}],["$","$L7",null,{"src":{"src":"/_next/static/media/wordpress-web-1.c04301e6.webp","width":1256,"height":664,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"introimg-1"}]]}],["$","div",null,{"className":"commonIntroduction-module__IKzCgq__box","children":[["$","$L7",null,{"src":{"src":"/_next/static/media/wordpress-web-2.3a5d55d0.webp","width":1256,"height":664,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"introimg-1"}],["$","div",null,{"className":"commonIntroduction-module__IKzCgq__gapcontent","dangerouslySetInnerHTML":{"__html":"  <p>Creating websites that are easy to use, fast, and compatible with any device helps attract visitors and keep them coming back. We offer a full range of WordPress CMS customization and maintenance services designed to deliver seamless functionality and user-friendly experiences.</p>\n                <p>At Website Development Agency, we ensure your website’s security, scalability, and performance for long-term success. When you choose us, you’re partnering with a UAE-based WordPress expert who understands your business, audience, and digital goals.</p>\n                    "}}]]}]]}]]}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e"],["$L1f","$L20","$L21","$L22","$L23"],"$L24"]}]
