11:["$","$1","c",{"children":[[["$","div",null,{"className":"sm-mb-50 commonBanner2-module__m8QleG__commonbanner2","style":{"--bg":"url(/_next/static/media/php-banner.6cd03532.webp) no-repeat center center / cover"},"children":["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-10 sm-px-20 commonBanner2-module__m8QleG__content","children":[["$","h2",null,{"dangerouslySetInnerHTML":{"__html":"Core PHP Web Development <br>Company in UAE"}}],["$","p",null,{"className":"my-30","dangerouslySetInnerHTML":{"__html":"At Website Development Agency, we create powerful, secure, and scalable PHP websites </br>that combine performance with exceptional user experience."}}],["$","$L8",null,{"href":"/contact-us","className":"blue-btn","children":"Get a Free Consultation"}]]}]}],["$","$L15",null,{"title":"Dev. Services","items":[{"name":"UI/UX","link":"/services/ui-ux-design"},{"name":"Frontend Dev.","link":"/services/frontend-development"},{"name":"Full-stack Dev.","link":"/services/full-stack-development"},{"name":"Static Web Dev.","link":"/services/static-website-development"},{"name":"Dynamic Web Dev.","link":"/services/dynamic-website-development"},{"name":"Website Migration","link":"/services/website-migration-service"}]}],["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","h2",null,{"children":"PHP Website Development Services"}],["$","div",null,{"className":"commonIntroduction-module__IKzCgq__flex","children":[["$","div",null,{"className":"commonIntroduction-module__IKzCgq__box","children":[["$","div",null,{"className":"commonIntroduction-module__IKzCgq__gapcontent","dangerouslySetInnerHTML":{"__html":" <p>At <a href=\"/\">Website Development Agency in Dubai</a>, we are a reputable PHP web development agency in Dubai and the UAE. We enable businesses to build digital solutions that are fast, flexible, and future-ready. With 10+  years of experience and a team of skilled developers, we are proficient in designing websites and web applications based on PHP that are robust and specifically tailored to meet the specific requirements of our clients.</p>\n                    <p>We have extensive expertise in major PHP-based platforms- Laravel, CodeIgniter, and Symfony. This enables us to create dynamic, feature-rich websites and web apps to help your business grow and thrive. Our PHP website solutions are designed to impress not only with their functionality but also with their ability to give you long-term value, whether you require a website or a custom web application.</p>\n                    "}}],["$","$L7",null,{"src":{"src":"/_next/static/media/php-website-dev-1.1e0f1f14.webp","width":1256,"height":664,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"introimg-1"}]]}],["$","div",null,{"className":"commonIntroduction-module__IKzCgq__box","children":[["$","$L7",null,{"src":{"src":"/_next/static/media/php-website-dev-2.64c616a5.webp","width":1256,"height":664,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/webp;base64,"},"alt":"introimg-1"}],"$L16"]}]]}]]}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"],["$L20","$L21","$L22","$L23","$L24"],"$L25"]}]
