b:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","children":["$","h2",null,{"children":"Growth-Focused Website Solutions for Local Businesses"}]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","p",null,{"children":"We build business websites that adapt to the specific focus of your studio. Every platform is planned around your service catalog, local story, and customer engagement goals."}]}]]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex CommonWhyWebsiteDevelopment-module__smXB6a__bottom","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","dangerouslySetInnerHTML":{"__html":"<p><b>Professional Services (Consultants, Coaches):</b> We create clean websites that highlight individual expertise, success stories, and specialized advice, emphasizing personal trust and authority.</p>\n                                <p><b>Local Shops & Boutiques:</b> For retail businesses, our designs focus on product charm, local personality, and ease of purchase, positioning you as a heart-of-the-community favorite.</p>\n                                <p><b>Service Companies (Repairs, Beauty):</b> Websites for local service firms focus on availability, transparent pricing, and customer reviews, showcasing your reliability for home and personal care.</p>\n                                <p><b>Startup Innovative Venturess:</b> We design platforms for new ventures that focus on unique value propositions, founder stories, and early-stage engagement, utilizing detailed landings and community hubs.</p>\n                            "}}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","$L3",null,{"src":{"src":"/_next/static/media/why-choose.41d762f4.webp","width":1132,"height":1128,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"},"alt":"Why Website Development"}]}]]}]]}]
