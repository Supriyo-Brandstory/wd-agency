d:["$","$L1d",null,{"testimonials":[{"id":1,"name":"John Carter","text":"Website Development Agency built a site that finally matches the professionalism of our cleaning crew. Our online bookings have tripled in three months.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Fatima Al-Sayed","text":"The integration of the quote calculator has been a game-changer. We spend much less time on the phone and more time managing our cleaning teams.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Michael Chen","text":"High-quality design and exceptional SEO performance. We are now the top-ranking cleaning service in our target Dubai neighborhoods. Outstanding work!","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
