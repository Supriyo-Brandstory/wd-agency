b:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","children":["$","h2",null,{"children":"Cleaning Website Solutions for Diverse Service Focus"}]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","p",null,{"children":"We build cleaning websites that adapt to the specific focus of your company. Every platform is planned around your service catalog, target audience, and operational workflow."}]}]]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex CommonWhyWebsiteDevelopment-module__smXB6a__bottom","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","dangerouslySetInnerHTML":{"__html":"<p><b>Residential Maid Services:</b> Our designs focus on approachability, trustworthiness, and easy recurring booking options, making it simple for families and busy professionals to invite your team into their homes.</p>\n                                <p><b>Commercial & Office Cleaning:</b> For B2B focused firms, we emphasize reliability, insurance coverage, and professional management, using structured layouts that appeal to facility managers and business owners. </p>\n                                <p><b>Industrial & Post-Construction:</b> Websites for specialized cleaning focus on technical capability, safety certifications, and large-scale project handling, showcasing your ability to tackle the toughest jobs. </p>\n                                <p><b>Niche Specialized Cleaning:</b> Whether you focus on pools, windows, or high-end upholstery, we create tailored content and visual galleries that highlight your specialized skills and material knowledge.</p>\n                            "}}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","$L3",null,{"src":{"src":"/_next/static/media/wbhy-corporate-need-website.34446eaa.webp","width":3024,"height":1204,"blurWidth":8,"blurHeight":3,"blurDataURL":"data:image/webp;base64,UklGRsIAAABXRUJQVlA4TLUAAAAvB4AAAM1VICICHggACQAAAABF0AwB8GEIAAAAAAAAAAAAAAABAAAAAAAAcAAAEBsMvAEAAAAAwAMBpgEAAAA4f6vOFwkAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABAwJnLAwE5AQAAADj/LxoAAgAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAADqd/tIn9uW+44GvNkq4T/Y6zCpXwa6pl+/4OSd8Rci3SkWQtQbTSYBAA=="},"alt":"Why Website Development"}]}]]}]]}]
