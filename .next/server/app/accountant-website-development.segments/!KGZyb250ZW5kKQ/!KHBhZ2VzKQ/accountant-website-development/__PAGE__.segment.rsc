8:["$","div",null,{"className":"frame-1200 py-100 sm-pt-10 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"text-center sm-text-start mb-50 sm-mb-20","children":[["$","h2",null,{"className":"mb-20","children":"Accountant Website Design Dubai- Cost Breakdown"}],["$","p",null,{"children":"Choose CPA website design and development solution designed to strengthen your professional image and support sustainable growth in the UAE."}]]}],["$","div",null,{"className":"CommonCostBreakdown-module__YFR4nq__scrollHint","children":[["$","span",null,{"children":"Swipe horizontally to view full table"}],["$","svg",null,{"fill":"none","height":"20","viewBox":"0 0 24 24","width":"20","xmlns":"http://www.w3.org/2000/svg","children":["$","path",null,{"d":"M12 5V19M12 5L6 11M12 5L18 11","stroke":"currentColor","strokeLinecap":"round","strokeLinejoin":"round","strokeWidth":"2","transform":"rotate(270 12 12)"}]}]]}],["$","div",null,{"className":"CommonCostBreakdown-module__YFR4nq__chart","children":[["$","div",null,{"className":"CommonCostBreakdown-module__YFR4nq__grid","children":[["$","h3",null,{"children":"Web Design Solution"}],["$","h3",null,{"children":"Benefits"}],["$","h3",null,{"children":"Price Range Estimate"}]]}],[["$","div","0",{"className":"CommonCostBreakdown-module__YFR4nq__grid","children":[["$","p",null,{"children":"Basic"}],["$","p",null,{"children":"Affordable, creative"}],["$","p",null,{"className":"CommonCostBreakdown-module__YFR4nq__price","children":"AED 3,000- 5,000"}]]}],["$","div","1",{"className":"CommonCostBreakdown-module__YFR4nq__grid","children":[["$","p",null,{"children":"Standard"}],["$","p",null,{"children":"Feature-rich, creative"}],["$","p",null,{"className":"CommonCostBreakdown-module__YFR4nq__price","children":"AED 5,000- 8,000"}]]}],["$","div","2",{"className":"CommonCostBreakdown-module__YFR4nq__grid","children":[["$","p",null,{"children":"Advanced"}],["$","p",null,{"children":"Well-structured, growth-ready"}],["$","p",null,{"className":"CommonCostBreakdown-module__YFR4nq__price","children":"AED 8,000- 12,000"}]]}],["$","div","3",{"className":"CommonCostBreakdown-module__YFR4nq__grid","children":[["$","p",null,{"children":"Premium"}],["$","p",null,{"children":"Premium, custom-built"}],["$","p",null,{"className":"CommonCostBreakdown-module__YFR4nq__price","children":"AED 12,000+"}]]}]]]}]]}]
