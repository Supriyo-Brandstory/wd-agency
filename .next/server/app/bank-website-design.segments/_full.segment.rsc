1e:["$","$L33",null,{"testimonials":[{"id":1,"name":"Ahmed Al-Farsi","text":"Website Development Agency delivered a secure and aesthetically pleasing platform for our boutique investment firm. Their understanding of financial requirements was impressive.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Sarah Jenkins","text":"A highly professional team that understands the importance of data security. Our new customer portal has significantly improved user engagement metrics.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Mohammed Rashid","text":"Excellent service and deep technical expertise. Our institution's search ranking has improved, and the feedback from our clients on the new mobile experience has been fantastic.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
