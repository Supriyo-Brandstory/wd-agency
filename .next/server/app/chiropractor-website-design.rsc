1c:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","children":["$","h2",null,{"children":"Wellness Website Solutions for Every Specialization"}]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","p",null,{"children":"We design chiropractic websites that adapt to the specific focus of your clinic. Every website is planned around your unique treatments, patient demographic, and clinic objectives."}]}]]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex CommonWhyWebsiteDevelopment-module__smXB6a__bottom","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","dangerouslySetInnerHTML":{"__html":"<p><b>Family Chiropractic:</b> We build warm, approachable websites that resonate with parents and families, emphasizing safe care for all ages and comprehensive wellness plans for the entire household.</p>\n                                <p><b>Sports & Performance:</b> For clinics focused on athlete recovery, our designs emphasize performance, biomechanics, and rapid injury return, using dynamic visuals and technical service descriptions to appeal to active individuals. </p>\n                                <p><b>Corrective & Rehabilitative:</b> Websites for corrective clinics focus on long-term spinal health, utilizing educational diagrams and structured treatment journey pages to communicate the value of structural correction.</p>\n                                <p><b>Multidisciplinary Wellness:</b> If your clinic offers massage, physiotherapy, or nutrition alongside chiropractic, we create clear service hierarchies that reflect your holistic approach to health.</p>\n                            "}}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","$L7",null,{"src":{"src":"/_next/static/media/why-choose.af5e43ee.webp","width":1132,"height":1128,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"},"alt":"Why Website Development"}]}]]}]]}]
