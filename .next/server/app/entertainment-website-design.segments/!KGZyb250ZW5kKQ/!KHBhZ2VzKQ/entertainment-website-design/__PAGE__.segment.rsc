b:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","children":["$","h2",null,{"children":"Security Website Solutions for Specialized Firms"}]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","p",null,{"children":"We build technology websites that adapt to the specific focus of your security firm. Every platform is planned around your service catalog, technical expertise, and client engagement goals."}]}]]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex CommonWhyWebsiteDevelopment-module__smXB6a__bottom","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","dangerouslySetInnerHTML":{"__html":"<p><b>Managed Security Services (MSSPs):</b> We create comprehensive websites that highlight SOC capabilities, 24/7 monitoring services, and incident response frameworks, emphasizing reliability and continuous protection.</p>\n                                <p><b>Cybersecurity Consulting:</b> For advisory firms, our designs focus on strategic frameworks, regulatory compliance (like NESA or ISR), and executive-level thought leadership, positioning you as a key business partner. </p>\n                                <p><b>Penetration Testing & Red Teaming:</b> Websites for assessment firms focus on technical methodology, case studies, and certification levels, showcasing your ability to identify and mitigate complex vulnerabilities. </p>\n                                <p><b>Identity & Access Management:</b> We design platforms for specialized security vendors that focus on zero-trust architectures and user protection, utilizing detailed product pages and technical whitepapers.</p>\n                            "}}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","$L3",null,{"src":{"src":"/_next/static/media/why-choose.41d762f4.webp","width":1132,"height":1128,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"},"alt":"Why Website Development"}]}]]}]]}]
