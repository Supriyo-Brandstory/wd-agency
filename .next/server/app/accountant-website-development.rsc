1c:["$","$L35",null,{"testimonials":[{"id":1,"name":"Ahmed M.","text":"The Website Development Agency team built a website that perfectly captures the professional essence of our audit firm. The secure portal is a game-changer.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Fatima S.","text":"From start to finish, the process was seamless. Our new site has significantly increased our high-quality leads from international clients.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Robert L.","text":"Highly professional and technically skilled. They understood our complex requirements for VAT calculators and delivered beyond expectations.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
