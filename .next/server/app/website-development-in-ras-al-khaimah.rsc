19:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"commonServices-module__ns43GG__topSection","children":[["$","div",null,{"className":"commonServices-module__ns43GG__left","style":{"--width":"40%"},"children":["$","h2",null,{"className":"mb-20 ","children":"The Website Design & Development Process We Follow"}]}],["$","div",null,{"className":"commonServices-module__ns43GG__right","style":{"--width":"60%"},"children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":" <p>Our website development process begins with understanding your business, target audience, and goals. We conduct thorough research and analysis to define the project scope, create detailed wireframes, and plan the website’s structure. This ensures that every element, from navigation to content placement, is aligned with your objectives and provides a seamless experience.</p>\n                <p class='my-20'>Once the blueprint is ready, our design and development teams collaborate to bring the website to life. We focus on responsive design, intuitive interfaces, and optimized performance. After development, we conduct extensive testing for functionality, speed, and security before launching the site.</p>\n                "}}]}]]}],["$","div",null,{"className":"commonServices-module__ns43GG__bottomSection","style":{"--bg-url":"url(/_next/static/media/developmentprocess.05e10ae5.webp)"},"children":["$","div",null,{"className":"frame-700","style":{"margin":"0 0"},"children":[["$","h4",null,{"className":"mb-20","children":"Our detailed website development process include:"}],["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<ul class='ml-50'>\n                <li>Discovery & Research- Being acknowledged with your business, your competitors, and your goals.</li>\n                <li>Wireframing & Design- Outlining designs that weigh beauty with usability. </li>\n                <li>Development & Coding- Building working, responsive, and safe sites utilizing the latest technologies.</li>\n                <li>Testing & QA- Examining for speed, functions, and responsiveness throughout several devices.</li>\n                <li>Launch & Optimization- Introducing your website and leveraging it for search.</li>\n            </ul>\n            "}}]]}]}]]}]
