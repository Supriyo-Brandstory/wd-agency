1e:["$","$L39",null,{"testimonials":[{"id":1,"name":"Marco D.","text":"The new website completely changed how we handle our luxury car inventory. The 360 virtual tours are a massive hit with our international clients.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Sarah J.","text":"Sales leads jumped by 40% in just two months. The integration with our DMS was flawless and saved us countless hours of manual work.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Khalid A.","text":"Highly professional team. They understood the Dubai market perfectly and delivered a high-performance site that looks incredible on mobile.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
