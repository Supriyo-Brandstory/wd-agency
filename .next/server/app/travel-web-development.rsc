31:["$","div","7",{"className":"commonThreeCard-module__C821FW__card","children":[["$","div",null,{"className":"commonThreeCard-module__C821FW__imgbox","children":["$","$L7",null,{"src":{"src":"/_next/static/media/SEO-Friendly-Architecture.307bb80b.png","width":110,"height":110,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/png;base64,"},"alt":"Icon"}]}],["$","h4",null,{"className":"my-15","children":"SEO-Friendly Architecture"}],["$","p",null,{"children":"As you will know, your travel agency website is only truly effective when it has structured URLs, optimized meta data and clean coding. These will all make a positive contribution to Google, giving your website a competitive edge in visibility."}],"$undefined"]}]
