c:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"commonServices-module__ns43GG__topSection","children":[["$","div",null,{"className":"commonServices-module__ns43GG__left","style":{"--width":"40%"},"children":["$","h2",null,{"className":"mb-20 ","children":"The Website Development Agency Methodology"}]}],["$","div",null,{"className":"commonServices-module__ns43GG__right","style":{"--width":"60%"},"children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":" <p>At Website Development Agency, we believe in a collaborative, transparent, and measurable approach for every project we undertake. We keep you informed at every stage- from strategy to execution, ensuring complete clarity and alignment.</p>\n                    <p class='mt-20'>Our structured and forward-thinking web development process not only drives measurable outcomes but also encourages creative solutions that set your business apart and deliver lasting commercial success.</p>\n                "}}]}]]}],["$","div",null,{"className":"commonServices-module__ns43GG__bottomSection","style":{"--bg-url":"url(/_next/static/media/DevelopmentProcess.7deea4db.webp)"},"children":["$","div",null,{"className":"frame-700","style":{"margin":"0 0"},"children":[["$","h4",null,{"className":"mb-20","children":"Steps We Follow in Our Web Development Process:"}],["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<ul class='ml-50'>\n                <li>Discovery & Research- Understanding requirements, competitor analysis, and audience mapping.</li>\n                <li>Strategy & Architecture- Content strategy, branding strategy, and conversion mapping.</li>\n                <li>Design- Wireframes, <a href=\"/services/wireframing-prototyping\">interactive prototypes</a>, brand-consistent UI.</li>\n                <li>Development- Agile development, unit & integration testing, API development.</li>\n                <li>Testing & Optimisation- Load testing, security scanning, cross-browser and device QA.</li>\n                <li> Launch & Maintenance- Structured rollout, continuous monitoring, and performance tracking.</li>\n            </ul>\n            <p class='mt-20'>We provide project deadlines, milestones, utilize tools (project boards, regular demos) so you always know the progress.</p>\n            "}}]]}]}]]}]
