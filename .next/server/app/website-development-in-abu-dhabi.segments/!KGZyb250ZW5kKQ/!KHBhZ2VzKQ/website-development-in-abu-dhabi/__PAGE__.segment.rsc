f:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","h2",null,{"className":"text-center sm-text-start","children":"We Follow Results-Driven Web Design Principles"}],["$","p",null,{"className":"my-20 text-center sm-text-start","children":"Great website design connects a visitor’s journey from initial impact to conversation. We are the expert web design agency in Abu Dhabi creating websites that don’t just look good and functional, but also work across all devices. From intuitive UX design to high end visuals, we outline websites attract, engage, and keep users engaged."}],["$","h3",null,{"className":"text-center mb-40 sm-text-start"}],["$","div",null,{"className":"commonResult-module__-FHNbW__cardbox","children":[["$","div","0",{"className":"commonResult-module__-FHNbW__card","children":[["$","$L1b",null,{"src":{"src":"/_next/static/media/custom-design.765ec358.png","width":604,"height":850,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/png;base64,"},"alt":"Custom Design","className":"commonResult-module__-FHNbW__image"}],["$","div",null,{"className":"commonResult-module__-FHNbW__overlay","children":[["$","h4",null,{"className":"mb-10","children":"Custom Design"}],["$","p",null,{"children":"Fully responsive for smartphones, tablets, and desktops."}]]}]]}],["$","div","1",{"className":"commonResult-module__-FHNbW__card","children":[["$","$L1b",null,{"src":{"src":"/_next/static/media/SEO-Centric.4b0b08f4.webp","width":604,"height":850,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"},"alt":"Custom Design","className":"commonResult-module__-FHNbW__image"}],["$","div",null,{"className":"commonResult-module__-FHNbW__overlay","children":[["$","h4",null,{"className":"mb-10","children":"SEO-Centric"}],["$","p",null,{"children":"Organized with on-page SEO basics in mind."}]]}]]}],["$","div","2",{"className":"commonResult-module__-FHNbW__card","children":[["$","$L1b",null,{"src":{"src":"/_next/static/media/Mo