b:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","children":["$","h2",null,{"children":"Relocation Website Solutions for Specialized Firms"}]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","p",null,{"children":"We build moving websites that adapt to the specific focus of your relocation firm. Every platform is planned around your service catalog, local footprint, and client engagement goals."}]}]]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex CommonWhyWebsiteDevelopment-module__smXB6a__bottom","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","dangerouslySetInnerHTML":{"__html":"<p><b>Residential Packers & Movers:</b> We create comprehensive websites that highlight household care, packing expertise, and local transit safety, emphasizing peace of mind for families.</p>\n                                <p><b>Commercial & Office Relocation:</b> For business movers, our designs focus on downtime minimization, IT equipment handling, and project management scale, positioning you as a professional partner.</p>\n                                <p><b>International Relocation:</b> Websites for global movers focus on shipping routes, customs expertise, and international agent networks, showcasing your ability to handle complex cross-border moves.</p>\n                                <p><b>Specialized Furniture Moving:</b> We design platforms for piano and antique movers that focus on specialized equipment and protection techniques, utilizing detailed service pages and safety stories.</p>\n                            "}}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","$L3",null,{"src":{"src":"/_next/static/media/why-choose.41d762f4.webp","width":1132,"height":1128,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"},"alt":"Why Website Development"}]}]]}]]}]
