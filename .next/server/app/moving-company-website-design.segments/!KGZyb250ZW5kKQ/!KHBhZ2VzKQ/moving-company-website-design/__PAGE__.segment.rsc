d:["$","$L1d",null,{"testimonials":[{"id":1,"name":"Gary Johnson","text":"Website Development Agency built a digital presence that has transformed our lead generation. Our new quote calculator has made it so much easier for clients to choose us.","image":{"src":"/_next/static/media/testimonial-1.705df05b.webp","width":468,"height":666,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":2,"name":"Fatima Al-Kamali","text":"A highly creative team that understands the local market. They delivered a helpful, authoritative website that has positioned our firm as the go-to for residential moves in Dubai.","image":{"src":"/_next/static/media/testimonial-2.9e883495.webp","width":424,"height":684,"blurWidth":5,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"id":3,"name":"Brian Thompson","text":"Excellent service from start to finish. Our search rankings for 'movers and packers' in Dubai have shot up, and the site's mobile performance is exceptional.","image":{"src":"/_next/static/media/testimonial-3.b1bc37f6.webp","width":486,"height":702,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]
