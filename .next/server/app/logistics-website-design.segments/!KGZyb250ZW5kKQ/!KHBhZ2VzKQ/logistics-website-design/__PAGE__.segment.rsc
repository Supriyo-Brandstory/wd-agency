b:["$","div",null,{"className":"frame-1200 py-100 sm-pt-0 sm-pb-50 sm-px-20","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","children":["$","h2",null,{"children":"Supply Chain Website Solutions for Specialized Firms"}]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","p",null,{"children":"We build logistics websites that adapt to the specific focus of your transport firm. Every platform is planned around your service catalog, operational footprint, and client engagement goals."}]}]]}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__flex CommonWhyWebsiteDevelopment-module__smXB6a__bottom","children":[["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__left","dangerouslySetInnerHTML":{"__html":"<p><b>Freight Forwarders (Sea, Air, Land):</b> We create comprehensive websites that highlight global carrier networks, customs clearance expertise, and end-to-end transport frameworks, emphasizing speed and reliability.</p>\n                                <p><b>3PL & Warehousing:</b> For storage specialists, our designs focus on inventory management, fulfillment speed, and distribution network scale, positioning you as a key supply chain partner.</p>\n                                <p><b>Specialized Cargo (Cold Chain, Project Cargo):</b> Websites for niche transporters focus on technical methodology, specialized equipment, and safety certifications, showcasing your ability to handle complex requirements.</p>\n                                <p><b>Last-Mile & E-commerce Logistics:</b> We design platforms for delivery specialists that focus on technology integration, route optimization, and client transparency, utilizing detailed tracking and driver portals.</p>\n                            "}}],["$","div",null,{"className":"CommonWhyWebsiteDevelopment-module__smXB6a__right","children":["$","$L3",null,{"src":{"src":"/_next/static/media/why-choose.41d762f4.webp","width":1132,"height":1128,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"},"alt":"Why Website Development"}]}]]}]]}]
